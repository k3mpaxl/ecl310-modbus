#!/usr/bin/env python3
"""Turn Danfoss ECL Tool application reports into application profiles.

The ECL Tool ships one XML report per application and version - every
parameter the application has, with its data type, scale, unit, range,
default and whether it may be written. This script reads the reports for the
applications named on the command line and writes one compact Python module
per report to ``src/ecl310_modbus/applications``, then regenerates the
catalogue next to them. Only the derived parameter metadata ends up in the
library, never the report itself.

Usage::

    scripts/import-ecl-tool "ECL Tool.zip" "A237_1 V04" "A337_2 V02"

The first argument is the ECL Tool zip or its unpacked folder; the others name
reports as they are called inside it (``Reports/<name>.xml``). Run it again
with no report names to only rebuild the catalogue.

The reports come from outside this repository: they are read straight out of
the zip, never unpacked, and only their attributes are used. The German display
texts come from the tool's language table (``Language/ECL7Gen languages Db.txt``):
a parameter gets the German text of the entry whose English text is its name -
looked up by its parameter number first, then by the circuit-1 number, then by
the English text alone where that is unambiguous.

What the circuits, sensor inputs, relays and triacs do is derived by fixed
rules (see ``derive_roles``):

* A circuit with a heat curve (``1n175``) is a heating circuit, one with a hot
  water setpoint (``1n190``) a hot water circuit.
* The read-only ``Sx sensor reference`` parameters sit in the group of what the
  sensor measures: ``Flow temperature_2`` makes ``Sx`` circuit 2's flow.
  ``S1 sensor`` is the outdoor sensor.
* Danfoss wires pump ``Px`` to relay ``x`` and motorised valve ``Mx`` to triacs
  ``2x-1`` (open) and ``2x`` (close). Which pump a ``Px`` is, and which circuit
  a valve serves, is only in the application guides: ``PUMPS`` and ``VALVES``.
* A role that would occur twice - two heating circuits each with a flow
  sensor - is suffixed with its circuit on all of them: ``_circuit_1``,
  ``_circuit_2``.

Inputs no reference parameter names are taken from the guides, in
``EXTRA_SENSORS``.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import zipfile
from dataclasses import dataclass
from pathlib import Path
from xml.etree import ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
TARGET = ROOT / "src" / "ecl310_modbus" / "applications"
NAMESPACE = "{schema.danfoss.com/ecl}"

#: Values a parameter stores to mean "off", one step outside its settable
#: range and shown as ``OFF`` on the controller. The reports do not mark them,
#: so they are kept here, by function - a circuit parameter's last three
#: digits, the same on every circuit - as they become known.
OFF_VALUES: dict[int, int] = {
    125: 9,  # anti-bacteria desired temperature (1x125): 9 = OFF
}


def off_value(pnu: int) -> int | None:
    """The "off" value of a circuit parameter, if its function has one."""
    if not 11000 <= pnu < 17000:
        return None
    return OFF_VALUES.get(pnu % 1000)

#: Circuit kinds, by the parameter that marks them (last three digits).
HEAT_CURVE = 175
HOT_WATER_SETPOINT = 190
HEATING = "heating"
HOT_WATER = "hot_water"

#: What a sensor measures, by the group its reference parameter sits in.
SENSOR_GROUPS: dict[str, str] = {
    "Flow temperature": "flow_temperature",
    "Return limit": "return_temperature",
    "Room limit": "room_temperature",
    "Tank temperature": "storage_temperature",
}

#: Roles that name a hot water circuit's sensor apart from a heating circuit's.
HOT_WATER_PREFIXED = {"flow_temperature", "return_temperature"}

SENSOR_PARAMETER = re.compile(r"^S(?P<number>\d+) sensor(?: reference)?$")

#: Inputs no reference parameter names, from the application guides.
EXTRA_SENSORS: dict[str, dict[int, str]] = {
    # Operating guide A266 (VI.KT.X5.02), 2.5.4, subtypes .9 and .10.
    "A266.9": {
        2: "secondary_return_temperature",
        6: "hot_water_return_temperature",
    },
    "A266.10": {
        2: "secondary_return_temperature",
        6: "hot_water_return_temperature",
    },
}

#: What each pump ``Px`` is and the circuit it serves, from the guides. Danfoss
#: wires ``Px`` to relay ``x``.
PUMPS: dict[str, dict[int, tuple[str, int]]] = {
    # Operating guide A237/A337 (AQ000086479358de-000502), 2.1 component lists.
    "A237.1": {
        1: ("heating_pump", 1),
        2: ("storage_charge_pump", 2),
        3: ("circulation_pump", 2),
    },
    "A337.2": {
        1: ("heating_pump", 1),
        2: ("storage_charge_pump", 2),
        3: ("circulation_pump", 2),
    },
    # Operating guide A266, 2.5.4; relays confirmed on an A266.10 (issue #35).
    "A266.9": {1: ("circulation_pump", 2), 2: ("heating_pump", 1)},
    "A266.10": {1: ("circulation_pump", 2), 2: ("heating_pump", 1)},
    # ECL Tool drawing A367_1 example a.
    "A367.1": {
        1: ("heating_pump", 1),
        2: ("storage_charge_pump", 3),
        3: ("circulation_pump", 3),
        5: ("heating_pump", 2),
    },
}

#: The circuit each motorised valve ``Mx`` serves, from the guides. Danfoss
#: wires ``Mx`` to triac ``2x-1`` (open) and ``2x`` (close).
VALVES: dict[str, dict[int, int]] = {
    "A237.1": {1: 1},
    "A337.2": {1: 1},
    "A266.9": {1: 2, 2: 1},
    "A266.10": {1: 2, 2: 1},
    "A367.1": {1: 1, 2: 2},
}

REPORT_NAME = re.compile(r"^(?P<app>[A-Z]\d+)(?:_(?P<sub>\d+))? V(?P<ver>\d+)$")
PROFILE_MODULE = re.compile(r"^[a-z]\d+(?:_\d+)?_v\d+$")
LINE_LENGTH = 88


@dataclass(frozen=True)
class Parameter:
    """One row of a report, as the profile stores it."""

    pnu: int
    group: str
    name: str
    type: str
    scale: int
    unit: str | None
    minimum: int | None
    maximum: int | None
    default: int | None
    writable: bool
    circuit: int = 0
    name_de: str | None = None
    options: tuple[tuple[int, str], ...] = ()


GROUP_CIRCUIT = re.compile(r"_(?P<circuit>\d+)$")
OPTION = re.compile(r"(?P<value>-?\d+)\s*=\s*(?P<text>[^;]+)")


def circuit_of(group: str) -> int:
    """``Flow temperature_1`` belongs to circuit 1; ``Input_config`` to none."""
    match = GROUP_CIRCUIT.search(group)
    return int(match["circuit"]) if match else 0


def options_of(description: str | None) -> tuple[tuple[int, str], ...]:
    """``1=Pt1000; 2=0-10 volt`` lists what the raw values mean."""
    if not description:
        return ()
    found = [(int(m["value"]), m["text"].strip()) for m in OPTION.finditer(description)]
    return tuple(found) if len(found) >= 2 else ()


class GermanTexts:
    """The display texts of the tool's language table, English to German."""

    def __init__(self, raw: str) -> None:
        lines = raw.splitlines()
        header = lines[0].split("\t")
        english, german = header.index("Text_English"), header.index("Text_German")
        self.by_id: dict[int, tuple[str, str]] = {}
        by_text: dict[str, set[str]] = {}
        for line in lines[3:]:
            cells = line.split("\t")
            if len(cells) <= german or not cells[0].strip().isdigit():
                continue
            pair = (cells[english].strip(), cells[german].strip())
            if not all(pair):
                continue
            self.by_id[int(cells[0])] = pair
            by_text.setdefault(pair[0], set()).add(pair[1])
        self.by_text = {
            en: next(iter(de)) for en, de in by_text.items() if len(de) == 1
        }

    def german(self, pnu: int, english: str) -> str | None:
        """The German text for parameter ``pnu`` named ``english``, if found.

        A circuit parameter's own number is its text ID, even where the report
        words its name differently from the display (11180 "Comfort room T" is
        "T-Komfort Soll"). Below 10000 text IDs are reused for other texts, so
        there - and for the circuit-1 fallback - the English text must match.
        """
        if schedule := SCHEDULE_NAME.match(english):
            day = WEEKDAYS_DE[schedule["day"]]
            state = "Ein" if schedule["state"] == "ON" else "Aus"
            return f"{day} P{schedule['period']} {state}"
        if english in NAMES_DE:
            return NAMES_DE[english]
        if pnu >= 10000 and (pair := self.by_id.get(pnu)):
            return pair[1]
        for text_id in (pnu, 11000 + pnu % 1000):
            pair = self.by_id.get(text_id)
            if pair and pair[0] == english:
                return pair[1]
        return self.by_text.get(english)


#: German names for report names the language table has no display text for.
#: Short codes (Xp, Tn, X1..Y6) are the controller's own and stay as they are.
NAMES_DE: dict[str, str] = {
    "Holiday Status": "Ferien Status",
    "Holiday Start Day": "Ferien Start Tag",
    "Holiday Start Month": "Ferien Start Monat",
    "Holiday Start Year": "Ferien Start Jahr",
    "Holiday End Day": "Ferien Ende Tag",
    "Holiday End Month": "Ferien Ende Monat",
    "Holiday End Year": "Ferien Ende Jahr",
    "MinOutdoorTemp": "Min. Außentemp.",
    "MinHourTime": "Min. Außentemp. Stunde",
    "MinMinuteTime": "Min. Außentemp. Minute",
    "MaxOutdoorTemp": "Max. Außentemp.",
    "MaxHourTime": "Max. Außentemp. Stunde",
    "MaxMinuteTime": "Max. Außentemp. Minute",
    "OutdoorTrend": "Außentemp. Trend",
    "Past Hour": "Letzte Stunde",
    "Total Hour": "Stunden gesamt",
    "Reference place": "Referenzort",
}
for _n in range(1, 7):
    NAMES_DE[f"Circuit {_n} status"] = f"Kreis {_n} Status"
for _n in range(1, 19):
    for _prefix in ("", "ECA 32 "):
        NAMES_DE[f"{_prefix}Config type S{_n}"] = f"{_prefix}Konfig. Typ S{_n}"
        NAMES_DE[f"{_prefix}Config option S{_n}"] = f"{_prefix}Konfig. Option S{_n}"
    NAMES_DE[f"S{_n} sensor"] = f"Fühler S{_n}"
    NAMES_DE[f"S{_n} sensor reference"] = f"Fühler S{_n} Referenz"
for _n in range(1, 9):
    NAMES_DE[f"H-Estrich point Y{_n}"] = f"Estrich Punkt Y{_n}"

SCHEDULE_NAME = re.compile(
    r"^(?P<day>Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday) "
    r"P(?P<period>\d) (?P<state>ON|OFF)$"
)
WEEKDAYS_DE = {
    "Monday": "Montag",
    "Tuesday": "Dienstag",
    "Wednesday": "Mittwoch",
    "Thursday": "Donnerstag",
    "Friday": "Freitag",
    "Saturday": "Samstag",
    "Sunday": "Sonntag",
}


def _literal(value: object) -> str:
    """Write a value as Python source, strings double-quoted."""
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    return repr(value)


def _int(value: str | None) -> int | None:
    return None if value in (None, "") else int(value)


def read_member(source: Path, member: str) -> bytes:
    """Return one file of the ECL Tool zip or folder."""
    if source.is_dir():
        return (source / member).read_bytes()
    with zipfile.ZipFile(source) as archive:
        matches = [n for n in archive.namelist() if n.endswith(member)]
        if len(matches) != 1:
            sys.exit(f"{member} not found in {source}")
        return archive.read(matches[0])


def read_report(source: Path, name: str) -> tuple[ET.Element, str]:
    """Return the parsed report ``name`` from the ECL Tool zip or folder."""
    member = f"Reports/{name}.xml"
    if source.is_dir():
        raw = (source / member).read_bytes()
    else:
        with zipfile.ZipFile(source) as archive:
            matches = [n for n in archive.namelist() if n.endswith(member)]
            if len(matches) != 1:
                sys.exit(f"{member} not found in {source}")
            raw = archive.read(matches[0])
    return ET.fromstring(raw.decode("utf-16")), member


def parameters(root: ET.Element, texts: GermanTexts | None = None) -> list[Parameter]:
    """Every parameter in a report, once each, by parameter number."""
    found: dict[int, Parameter] = {}
    for group in root.iter(f"{NAMESPACE}Group"):
        group_name = (group.text or "").strip()
        for param in group.iter(f"{NAMESPACE}Param"):
            attrs = param.attrib
            if "Min" not in attrs or "Max" not in attrs:
                continue  # an alarm, not a setting or reading
            pnu = int(attrs["PNU"])
            found.setdefault(
                pnu,
                Parameter(
                    pnu=pnu,
                    group=group_name,
                    name=(param.text or "").strip(),
                    type=attrs["Type"],
                    scale=int(attrs.get("Scale") or 1),
                    unit=attrs.get("Unit") or None,
                    minimum=_int(attrs.get("Min")),
                    maximum=_int(attrs.get("Max")),
                    default=_int(attrs.get("Default_val")),
                    writable=attrs.get("Writable") == "TRUE",
                    circuit=circuit_of(group_name),
                    name_de=(
                        texts.german(pnu, (param.text or "").strip()) if texts else None
                    ),
                    options=options_of(attrs.get("Descrip")),
                ),
            )
    return sorted(found.values(), key=lambda p: p.pnu)


def circuit_kinds(found: list[Parameter]) -> dict[int, str]:
    """Each circuit's kind: a heat curve makes it heating, a DHW setpoint hot water."""
    pnus = {p.pnu for p in found}
    kinds: dict[int, str] = {}
    for circuit in range(1, 7):
        base = 10000 + 1000 * circuit
        if base + HEAT_CURVE in pnus:
            kinds[circuit] = HEATING
        elif base + HOT_WATER_SETPOINT in pnus:
            kinds[circuit] = HOT_WATER
    return kinds


def numbered(roles: dict[int, tuple[str, int]]) -> dict[int, str]:
    """Suffix every role that occurs more than once with its circuit."""
    counts: dict[str, int] = {}
    for role, _circuit in roles.values():
        counts[role] = counts.get(role, 0) + 1
    return {
        number: f"{role}_circuit_{circuit}" if counts[role] > 1 else role
        for number, (role, circuit) in sorted(roles.items())
    }


def sensor_roles(
    app: str, found: list[Parameter], kinds: dict[int, str]
) -> dict[int, str]:
    """What each sensor input measures, from the reference parameters' groups."""
    roles: dict[int, tuple[str, int]] = {}
    for p in found:
        match = SENSOR_PARAMETER.match(p.name)
        if match is None:
            continue
        number = int(match["number"])
        group = GROUP_CIRCUIT.sub("", p.group)
        if number == 1 and group == "General":
            roles.setdefault(1, ("outdoor_temperature", 0))
            continue
        role = SENSOR_GROUPS.get(group)
        if role is None:
            continue
        if role in HOT_WATER_PREFIXED and kinds.get(p.circuit) == HOT_WATER:
            role = f"hot_water_{role}"
        roles.setdefault(number, (role, p.circuit))
    for number, role in EXTRA_SENSORS.get(app, {}).items():
        roles.setdefault(number, (role, 0))
    return numbered(roles)


def relay_roles(app: str) -> dict[int, str] | None:
    """What each relay drives: pump ``Px`` on relay ``x``; None if not known."""
    pumps = PUMPS.get(app)
    return None if pumps is None else numbered(dict(pumps))


def triac_roles(app: str, kinds: dict[int, str]) -> dict[int, str] | None:
    """What each triac drives: valve ``Mx`` opens on ``2x-1``, closes on ``2x``."""
    valves = VALVES.get(app)
    if valves is None:
        return None
    roles: dict[int, tuple[str, int]] = {}
    for valve, circuit in valves.items():
        prefix = "hot_water_" if kinds.get(circuit) == HOT_WATER else ""
        roles[2 * valve - 1] = (f"{prefix}valve_open", circuit)
        roles[2 * valve] = (f"{prefix}valve_close", circuit)
    return numbered(roles)


def module_text(
    name: str, root: ET.Element, member: str, texts: GermanTexts | None = None
) -> tuple[str, str]:
    """Return the profile module's name and source for report ``name``."""
    match = REPORT_NAME.match(name)
    if match is None:
        sys.exit(f"Cannot read an application and version from {name!r}")
    app = match["app"] + (f".{match['sub']}" if match["sub"] else "")
    version = int(match["ver"])
    device = root.find(f"{NAMESPACE}Device_App")
    if device is None:
        sys.exit(f"{member} has no Device_App")
    ecl_types = tuple(
        int(t.text) for t in device.iter(f"{NAMESPACE}ValidECL_Type") if t.text
    )
    key = f"{app.replace('.', '_').lower()}_v{version:02d}"

    lines = [
        f'"""{app} V{version:02d}: the parameters of this ECL application.',
        "",
        "Generated by ``scripts/import-ecl-tool`` from the Danfoss ECL Tool report",
        f"``{member}``. Do not edit by hand - run the script again.",
        '"""',
        "",
        "from .profile import ApplicationProfile, Parameter",
        "",
        "PROFILE = ApplicationProfile(",
        f'    key="{key}",',
        f'    application="{app}",',
        f"    version={version},",
        f"    ecl_types={ecl_types!r},",
    ]
    found = parameters(root, texts)
    kinds = circuit_kinds(found)
    relays = relay_roles(app)
    roles: list[tuple[str, dict[int, str]]] = [
        ("circuits", kinds),
        ("sensors", sensor_roles(app, found, kinds)),
        ("relays", {} if relays is None else relays),
    ]
    if (triacs := triac_roles(app, kinds)) is not None:
        roles.append(("triacs", triacs))
    for attribute, mapping in roles:
        if not mapping:
            lines.append(f"    {attribute}={{}},")
            continue
        lines.append(f"    {attribute}={{")
        lines += [f'        {number}: "{role}",' for number, role in mapping.items()]
        lines.append("    },")
    lines.append("    parameters={")
    for p in found:
        off = off_value(p.pnu)
        fields = [
            _literal(p.group),
            _literal(p.name),
            _literal(p.type),
            str(p.scale),
            _literal(p.unit),
            _literal(p.minimum),
            _literal(p.maximum),
            _literal(p.default),
            _literal(p.writable),
        ]
        if off is not None:
            fields.append(f"off={off}")
        if p.circuit:
            fields.append(f"circuit={p.circuit}")
        if p.name_de and p.name_de != p.name:
            fields.append(f"name_de={_literal(p.name_de)}")
        if p.options:
            pairs = ", ".join(f"{value}: {_literal(text)}" for value, text in p.options)
            fields.append(f"options={{{pairs}}}")
        # Laid out the way the formatter would, so the output passes as is.
        arguments = ", ".join(fields)
        line = f"        {p.pnu}: Parameter({arguments}),"
        if len(line) <= LINE_LENGTH:
            lines.append(line)
        elif len(f"            {arguments}") <= LINE_LENGTH:
            lines += [
                f"        {p.pnu}: Parameter(",
                f"            {arguments}",
                "        ),",
            ]
        else:
            lines.append(f"        {p.pnu}: Parameter(")
            for field in fields:
                if len(f"            {field},") <= LINE_LENGTH or not p.options:
                    lines.append(f"            {field},")
                    continue
                # Only the options grow this wide: one value per line.
                lines.append("            options={")
                lines += [
                    f"                {value}: {_literal(text)},"
                    for value, text in p.options
                ]
                lines.append("            },")
            lines.append("        ),")
    lines += ["    },", ")", ""]
    return key, "\n".join(lines)


def write_groups(source: Path) -> None:
    """Write the groups' display names, English and German, without circuit."""
    raw = read_member(source, "Language/Group texts.txt")
    text = (
        raw.decode("utf-16") if raw[:2] in (b"\xff\xfe", b"\xfe\xff") else raw.decode()
    )
    lines = text.splitlines()
    header = lines[0].split("\t")
    name, german = header.index("Name"), header.index("Text_German")
    groups: dict[str, tuple[str, str]] = {}
    for line in lines[1:]:
        cells = line.split("\t")
        if len(cells) <= german or not cells[name].strip():
            continue
        english = GROUP_CIRCUIT.sub("", cells[name].strip())
        groups.setdefault(
            english,
            (english, GROUP_CIRCUIT.sub("", cells[german].strip()).strip() or english),
        )
    out = [
        '"""The ECL Tool\'s parameter groups, as the controller\'s menus name them.',
        "",
        "Generated by ``scripts/import-ecl-tool`` from ``Language/Group texts.txt``.",
        "Do not edit by hand.",
        '"""',
        "",
        "#: English and German display name, by group without its circuit suffix.",
        "GROUP_NAMES: dict[str, tuple[str, str]] = {",
        *(
            f"    {_literal(key)}: ({_literal(en)}, {_literal(de)}),"
            for key, (en, de) in sorted(groups.items())
        ),
        "}",
        "",
    ]
    (TARGET / "groups.py").write_text("\n".join(out), encoding="utf-8")


def write_catalogue() -> None:
    """List every profile module in the package's catalogue."""
    keys = sorted(
        path.stem for path in TARGET.glob("*.py") if PROFILE_MODULE.match(path.stem)
    )
    lines = [
        '"""Every application profile this library carries.',
        "",
        "Generated by ``scripts/import-ecl-tool``. Do not edit by hand.",
        '"""',
        "",
        *(f"from .{key} import PROFILE as {key.upper()}" for key in keys),
        "from .profile import ApplicationProfile",
        "",
        "#: The profiles, by key.",
        "PROFILES: dict[str, ApplicationProfile] = {",
        *(f"    {key.upper()}.key: {key.upper()}," for key in keys),
        "}",
        "",
    ]
    (TARGET / "catalog.py").write_text("\n".join(lines), encoding="utf-8")


def main() -> None:
    """Import the named reports and rebuild the catalogue."""
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("source", type=Path, help="ECL Tool zip or folder")
    parser.add_argument("reports", nargs="*", help='report names, e.g. "A237_1 V04"')
    args = parser.parse_args()
    texts = None
    if args.reports:
        raw = read_member(args.source, "Language/ECL7Gen languages Db.txt")
        texts = GermanTexts(raw.decode("utf-16"))
    for name in args.reports:
        root, member = read_report(args.source, name)
        key, text = module_text(name, root, member, texts)
        (TARGET / f"{key}.py").write_text(text, encoding="utf-8")
        print(f"wrote {key}.py")
    if args.reports:
        write_groups(args.source)
        print("wrote groups.py")
    write_catalogue()
    print("wrote catalog.py")


if __name__ == "__main__":
    main()
